# Base URL da API usada pelo httpClient — obrigatória: sem ela, TODAS as chamadas
# (login incluído) lançam erro. Não há mais modo mock; o backend deve implementar
# o contrato descrito em todo/TODO_BACK.md.
VITE_API_BASE_URL=http://localhost:3000

# Caminho base do build. Em dev/E2E o padrão é "/"; o Docker define "/app/study/"
# (publicado pelo nginx dos microservices). Em produção, use VITE_API_BASE_URL=/
# para consumir a API na mesma origem.
VITE_BASE_PATH=

# Client ID do Google Identity Services, para o botão "Entrar com Google" na tela de login.
# O botão só aparece com essa variável preenchida. No console do Google, o client precisa ter
# o origin local (http://localhost:5173) em "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
